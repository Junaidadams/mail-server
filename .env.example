# ---------------------------------------------------------------------------
# Mail server environment variables
#
# Copy this file to `.env` (git-ignored) and fill in real values.
# Anything marked "TODO" must be changed before the service will send mail.
# ---------------------------------------------------------------------------

# Resend ----------------------------------------------------------------
# TODO: create an account at https://resend.com and grab an API key at
# https://resend.com/api-keys
RESEND_API_KEY=re_DUMMY_KEY_XXXXXXXXXXXXXX

# TODO: verify each sending domain at https://resend.com/domains and add
# the DNS records Resend gives you (SPF/DKIM/returns-to). Until a domain is
# verified, Resend rejects sends with "Domain not verified".

# junaidadams.com account -----------------------------------------------
# TODO: sender must be on the verified junaidadams.com domain
JUNIAIDADAMS_MAIL_FROM=contact@junaidadams.com
# TODO: where notifications for this site land (your inbox)
JUNIAIDADAMS_MAIL_TO=junaidadams117@gmail.com

# withinreach.co.za account -----------------------------------------------
# TODO: register/point withinreach.co.za DNS, then verify the domain in Resend
WITHINREACH_MAIL_FROM=contact@withinreach.co.za
# TODO: confirm this mailbox exists / DNS is active before going live
WITHINREACH_CONTACT_TO=info@withinreach.co.za

# ---------------------------------------------------------------------------
# Optional SMTP accounts (only for future accounts that must relay via their
# own mail host, e.g. when the deploy target does NOT block outbound SMTP:
# Render free tier blocks ports 25/465/587, so leave provider "resend" here).
# See the `example` account block in controllers/mail.controller.js.
# ---------------------------------------------------------------------------
# EXAMPLE_SMTP_HOST=mail.example.com
# EXAMPLE_SMTP_PORT=465
# EXAMPLE_SMTP_USER=forms@example.com
# EXAMPLE_SMTP_PASS=change-me